# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Mini App
# HTTPS URL of the frontend, e.g. https://mental-trader.pages.dev
MINIAPP_URL=
# Exact frontend origin for CORS, normally the same URL without a trailing slash.
MINIAPP_ORIGIN=
# Reopen the Mini App when initData is older than this value. 86400 = 24 hours.
MINIAPP_AUTH_MAX_AGE_SECONDS=86400

# Server-side admin/test key. Never put this value in frontend JavaScript.
BACKEND_API_KEY=change-this-to-a-long-random-secret

# FCS API: Forex + Metals
FCS_API_KEY=
# Optional override; normally leave unchanged.
FCS_BASE_URL=https://api-v4.fcsapi.com

# Twelve Data: Crypto + Nasdaq
TWELVE_DATA_API_KEY=

# HTTP server
API_HOST=0.0.0.0
API_PORT=8000
# Hosting providers may inject PORT automatically; it overrides API_PORT.

# Shared cache
PRICE_CACHE_SECONDS=15
# FCS free data updates every ~60s; lower this only if your plan updates faster.
FCS_PRICE_CACHE_SECONDS=60
CANDLE_CACHE_GRACE_SECONDS=4

# Strategy
TARGET_SIGNAL_RATE=0.70
ADAPTIVE_LOOKBACK=96
MIN_SCORE=40
STRONG_SCORE=80
BARS_COUNT=350
REQUEST_TIMEOUT_SECONDS=15

# Access/payment settings
DATABASE_PATH=bot.db
USDT_TRC20_ADDRESS=
BTC_ADDRESS=
MONTHLY_USD=50
LIFETIME_USD=180
BTC_USD_RATE=77000
